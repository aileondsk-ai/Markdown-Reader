# StyleFinder AI - 환경 변수 예시
# 복사 후 .env 로 저장하고 값을 채운 뒤 사용하세요. .env 파일은 Git에 커밋하지 마세요.

# === 필수 (로컬 개발) ===
DATABASE_URL=postgresql://stylefinder:devpassword@localhost:5432/stylefinder
SESSION_SECRET=your-secret-at-least-32-chars-long-for-dev

# === 로컬 개발 시 로그인 없이 mock 사용 (REPL_ID 없으면 자동 적용) ===
# REPL_ID=  # 비워두면 로컬 인증(mock) 사용

# === Replit 배포 시 (Replit에서 자동 설정되는 경우 많음) ===
# ISSUER_URL=
# REPL_ID=
# SESSION_SECRET=

# === OpenAI (Replit AI Integrations 사용 시) ===
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
